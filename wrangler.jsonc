{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf_ai_voice_chat",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_HISTORY",
        "class_name": "ChatHistory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatHistory"]
    }
  ]
}
